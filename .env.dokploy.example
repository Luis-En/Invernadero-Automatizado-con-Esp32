# Plantilla de variables para Dokploy.
# Pega esto en la pestaña "Environment" del servicio Compose y ajusta los
# valores. Dokploy lo guarda como .env junto al docker-compose.
#
# Guía completa: docs/deploy-dokploy-cloudflare.md

# --- Seguridad (obligatorias) ------------------------------------------
# Genera cada una con: openssl rand -hex 32
JWT_SECRET_KEY=CAMBIA_ESTO_openssl_rand_hex_32
DEVICE_API_TOKEN=CAMBIA_ESTO_openssl_rand_hex_32

# La API no arranca con ADMIN_PASSWORD vacío ni con menos de 12 caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_ADMIN
ADMIN_EMAIL=admin@greenhouse.local

# --- Túnel / dominio ---------------------------------------------------
# Token del túnel de Cloudflare (empieza por "eyJ").
CLOUDFLARE_TUNNEL_TOKEN=CAMBIA_ESTO_token_del_tunel
# Origen público real; debe ser https:// en producción.
PUBLIC_BASE_URL=https://invernadero.tudominio.com
# Mismo origen que PUBLIC_BASE_URL, como array JSON.
CORS_ORIGINS=["https://invernadero.tudominio.com"]

# --- Datos -------------------------------------------------------------
PHOTO_MAX_SIZE_MB=5
PHOTO_RETENTION_DAYS=30
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Bridge serial / simulación ---------------------------------------
# true = simulación (recomendado en un VPS sin hardware conectado)
SIMULATE=true
SIM_TELEMETRY_INTERVAL_SEC=30
SIM_PHOTO_INTERVAL_MIN=30
SIM_FIRST_PHOTO_DELAY_SEC=30

# Solo se usan con SIMULATE=false y acceso al USB del host.
# SERIAL_PORT=/dev/ttyUSB0
# SERIAL_BAUDRATE=115200
# SERIAL_DEVICE=/dev/ttyUSB0

# --- Clima (opcional) --------------------------------------------------
# Sin clave la UI de clima se oculta; el resto del sistema funciona igual.
OPENWEATHER_API_KEY=
WEATHER_ENABLED=true
WEATHER_LAT=14.3333
WEATHER_LON=-91.0167
WEATHER_LOCATION_NAME=Santa Lucía Cotzumalguapa
WEATHER_UNITS=metric
WEATHER_LANG=es
WEATHER_CACHE_TTL_SEC=600
WEATHER_STALE_MAX_SEC=7200
WEATHER_TIMEOUT_SEC=8
