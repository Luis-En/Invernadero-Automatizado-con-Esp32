# Plantilla de variables para Dokploy.
# Pega esto en la pestaña "Environment" del servicio Compose y ajusta
# los valores. Dokploy lo guarda como .env junto al docker-compose.

# --- Seguridad ---------------------------------------------------------
# Genera uno con: openssl rand -hex 32
JWT_SECRET_KEY=CAMBIA_ESTO_openssl_rand_hex_32

# Cambia las credenciales sembradas la primera vez que arranca la API.
# Si las dejas vacías se usan admin/admin123 y viewer/viewer123 (solo para
# pruebas). Con ADMIN_PASSWORD definido, la contraseña se sincroniza en cada
# arranque, así que también sirve para rotarla en un volumen existente.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_ADMIN
VIEWER_PASSWORD=CAMBIA_ESTA_CLAVE_VIEWER

# El bridge usa estas credenciales para leer la configuración activa.
# Deben coincidir con VIEWER_PASSWORD.
DEVICE_USERNAME=viewer
DEVICE_PASSWORD=CAMBIA_ESTA_CLAVE_VIEWER

# --- Dominio / CORS ----------------------------------------------------
# El frontend y la API se sirven desde el mismo origen, así que CORS no es
# estrictamente necesario. Si vas a llamar la API desde otro origen (o vas a
# entrar por IP:8080), ponlo como lista JSON, por ejemplo:
# CORS_ORIGINS=["http://10.160.66.170:8080"]
# CORS_ORIGINS=["https://invernadero.midominio.com"]
CORS_ORIGINS=["http://localhost"]

# --- Datos -------------------------------------------------------------
PHOTO_MAX_SIZE_MB=5
PHOTO_RETENTION_DAYS=30
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Bridge serial / simulación ---------------------------------------
# true = simulación (recomendado en un VPS sin hardware conectado)
SIMULATE=true
SIM_TELEMETRY_INTERVAL_SEC=30
SIM_PHOTO_INTERVAL_MIN=30
SIM_FIRST_PHOTO_DELAY_SEC=30

# Solo se usan con SIMULATE=false y acceso al USB del host.
# SERIAL_PORT=/dev/ttyUSB0
# SERIAL_BAUDRATE=115200
# SERIAL_DEVICE=/dev/ttyUSB0

# --- Clima (opcional) --------------------------------------------------
# Sin clave la UI de clima se oculta; el resto del sistema funciona igual.
OPENWEATHER_API_KEY=
WEATHER_ENABLED=true
WEATHER_LAT=14.3333
WEATHER_LON=-91.0167
WEATHER_LOCATION_NAME=Santa Lucía Cotzumalguapa
WEATHER_UNITS=metric
WEATHER_LANG=es
WEATHER_CACHE_TTL_SEC=600
WEATHER_STALE_MAX_SEC=7200
WEATHER_TIMEOUT_SEC=8

# --- MQTT --------------------------------------------------------------
# El broker corre en la red interna del compose y no se publica al exterior.
# Para conectar un ESP32 desde otra red necesitarás exponer 1883 con
# autenticación/TLS y ajustar MQTT_HOST/MQTT_PORT/MQTT_USERNAME/MQTT_PASSWORD.
MQTT_ENABLED=true
MQTT_PORT=1883
MQTT_DEVICE_ID=field_esp32
MQTT_TOPIC_PREFIX=invernadero
MQTT_TIMEOUT_SECONDS=5
