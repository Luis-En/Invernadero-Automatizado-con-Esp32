[greenhouse-login]
enabled = true
filter = greenhouse-login
logpath = __PROJECT_DIR__/data/logs/nginx/access.log
backend = auto
maxretry = 5
findtime = 10m
bantime = 1h
bantime.increment = true
bantime.maxtime = 1w
action = greenhouse-docker
# Never ban localhost. Add your own admin IP here if you test aggressively.
ignoreip = 127.0.0.1/8 ::1
