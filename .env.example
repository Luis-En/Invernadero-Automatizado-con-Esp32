# Database
DATABASE_URL=sqlite+aiosqlite:///./data/greenhouse.db

# JWT
JWT_SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Serial Bridge
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=115200
SIMULATE=true

# Photo storage
PHOTO_STORAGE_PATH=./data/photos
PHOTO_MAX_SIZE_MB=5
PHOTO_RETENTION_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Simulation
SIM_TELEMETRY_INTERVAL_SEC=30
SIM_PHOTO_INTERVAL_MIN=30
SIM_FIRST_PHOTO_DELAY_SEC=30

# Device credentials used by the serial bridge to read the active config
DEVICE_USERNAME=viewer
DEVICE_PASSWORD=viewer123